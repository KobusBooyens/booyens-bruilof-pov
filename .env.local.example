# ── Google OAuth (uploads run as a real Google user) ──────────────────
# A free personal Gmail has no "Shared Drive", and a service account has no
# storage of its own — so the app uploads as YOU via OAuth. Files are owned
# by this Google account and count against its 15 GB.
#
# Setup:
#   1. Google Cloud Console → create a project → enable the "Google Drive API".
#   2. APIs & Services → Credentials → Create OAuth client ID → type "Desktop app".
#   3. Paste the client id/secret below.
#   4. Run:  node scripts/get-refresh-token.mjs   → approve → copy the token.
GOOGLE_OAUTH_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_OAUTH_REFRESH_TOKEN="1//xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Drive folder ───────────────────────────────────────────────────────
# The ID from the root folder's URL:
# https://drive.google.com/drive/folders/<THIS_PART>
# Share this folder as "Anyone with the link: Viewer" so guests can view the
# photos/videos through the app's public thumbnail URLs.
GOOGLE_DRIVE_ROOT_FOLDER_ID="16_qop2AeyOhm_Fr6cZFECxf8hevOR3Po"

# ── Admin login (for the /admin QR page) ──────────────────────────────
# The /admin page shows the QR guests scan to open the app. Protected by this
# username/password (server-validated, httpOnly cookie). Change before deploy.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
